#!/bin/zsh
# Time each major section of .zshrc

time_it() {
    local start=$(date +%s%N)
    eval "$1" 2>/dev/null
    local end=$(date +%s%N)
    local elapsed=$(( (end - start) / 1000000 ))
    printf "%-40s %6d ms\n" "$2" "$elapsed"
}

echo "Timing .zshrc sections:"
echo "----------------------------------------"

time_it 'source $HOME/.oh-my-zsh/oh-my-zsh.sh' "Oh My Zsh"
time_it 'eval "$(starship init zsh)"' "Starship"
time_it 'eval "$(uv generate-shell-completion zsh)"' "UV completion"
time_it 'for f in ~/Documents/development/personal/dotfiles/aliases/*.zsh(N); do source "$f"; done' "Aliases"
time_it 'for f in ~/Documents/development/personal/dotfiles/functions/*.zsh(N); do source "$f"; done' "Functions"
time_it 'welcome' "Welcome screen"

echo "----------------------------------------"
echo ""
echo "Full shell startup:"
time zsh -i -c exit
